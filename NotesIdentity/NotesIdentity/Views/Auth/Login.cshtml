@model LoginViewModel

<link href="@Url.Content("~/views/styles/authstyles.css")" rel="stylesheet" type="text/css" />

<body>
    <div class="auth-container">
        <h2>Авторизация</h2>
        <form asp-controller="Auth" asp-action="Login" method="post">
            <div class="auth-input-container">
                <input asp-for="Username" class="auth-input" placeholder="Никнейм или электронная почта" />
                <span class="auth-error-text" asp-validation-for="Username"></span>
            </div>
            <div class="auth-input-container">
                <input asp-for="Password" class="auth-input" placeholder="Введите пароль" />
                <span class="auth-error-text" asp-validation-for="Password"></span>
            </div>
            <div>
                <input class="auth-submit-input" type="submit" value="Войти" />
            </div>

            <a class="auth-redirect-a" asp-controller="Auth" asp-action="Register">Зарегестрироваться</a>
        </form>
    </div>
</body>