@model PasswordChangingViewModel

<link href="@Url.Content("~/views/styles/authstyles.css")" rel="stylesheet" type="text/css" />

<body>
    <div class="auth-container">
        <h2>Изменение пароля</h2>
        <form asp-controller="Auth" asp-action="PasswordChanging" method="post">
            <div>
                <input asp-for="CurrentPassword" class="auth-input" placeholder="Текущий пароль" />
            </div>
            <div>
                <input asp-for="NewPassword" class="auth-input" placeholder="Новый пароль" />
            </div>
            <div>
                <input asp-for="NewPasswordConfiramtion" class="auth-input" placeholder="Подтвердите новый пароль" />
            </div>
            <div>
                <input type="submit" class="auth-submit-input" value="Изменить пароль" />
            </div>
        </form>
    </div>
</body>