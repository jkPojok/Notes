@model PasswordChangingViewModel

@*<link href="@Url.Content("~/views/styles/authstyles.css")" rel="stylesheet" type="text/css" />*@

<body>
    <div class="auth-container">
        <h2>Password changing</h2>
        <form asp-controller="Auth" asp-action="PasswordChanging" method="post">
            <div>
                <input asp-for="CurrentPassword" class="auth-input" placeholder="Your current password" />
            </div>
            <div>
                <input asp-for="NewPassword" class="auth-input" placeholder="Your new password" />
            </div>
            <div>
                <input asp-for="NewPasswordConfiramtion" class="auth-input" placeholder="Confirm your password" />
            </div>
            <div>
                <input type="submit" class="auth-submit-input" value="Change password" />
            </div>
        </form>
    </div>
</body>