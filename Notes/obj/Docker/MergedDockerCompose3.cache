name: dockercompose111944600268572887
services:
  notesapi:
    build:
      context: C:\Projects\NotesProject\Notes
      dockerfile: NotesApi/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
    image: notesapi
    networks:
      default: null
    ports:
    - mode: ingress
      target: 80
      published: "5000"
      protocol: tcp
    volumes:
    - type: bind
      source: C:\Users\Pojok\AppData\Roaming/Microsoft/UserSecrets
      target: /root/.microsoft/usersecrets
      read_only: true
      bind:
        create_host_path: true
    - type: bind
      source: C:\Users\Pojok\AppData\Roaming/ASP.NET/Https
      target: /root/.aspnet/https
      read_only: true
      bind:
        create_host_path: true
networks:
  default:
    name: dockercompose111944600268572887_default