name: dockercompose111944600268572887
services:
  notesapi:
    build:
      context: C:\Projects\NotesProject\Notes
      dockerfile: NotesApi/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: https://+:443;http://+:80
    image: notesapi
    networks:
      default: null
    ports:
    - mode: ingress
      target: 80
      protocol: tcp
    - mode: ingress
      target: 443
      protocol: tcp
    volumes:
    - type: bind
      source: C:\Users\Pojok\AppData\Roaming/Microsoft/UserSecrets
      target: /root/.microsoft/usersecrets
      read_only: true
      bind:
        create_host_path: true
    - type: bind
      source: C:\Users\Pojok\AppData\Roaming/ASP.NET/Https
      target: /root/.aspnet/https
      read_only: true
      bind:
        create_host_path: true
  notesfrontend:
    build:
      context: C:\Projects\NotesProject\Notes\notes-frontend
      dockerfile: Dockerfile
    image: notesfrontend
    networks:
      default: null
networks:
  default:
    name: dockercompose111944600268572887_default